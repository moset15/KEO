{
  "name": "keo",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev --host 0.0.0.0",
    "build": "node scripts/prepare-build.mjs && astro build && node scripts/build-worker.mjs",
    "check": "astro check && tsc --noEmit",
