---
import Layout from "../layouts/Layout.astro";
---

<Layout
  title="Read a screenshot & check its claim"
  description="Read screenshot text on your device, review it and inspect public sources without a paid language model."
>
  <div class="workspace">
    <header class="page-intro">
      <div class="eyebrow">ON-DEVICE TEXT READER</div><h1>
        Read the screenshot.<br />Check the evidence.
      </h1><p class="lede">
        Your image stays on this device. Extract its text, correct mistakes,
        then look up the claim in KEO’s curated evidence.
      </p>
    </header>
    <form id="keo-form" data-mode="investigate" data-local-image="true">
      <label class="upload" for="image-file"
        ><strong>Choose a screenshot or photograph</strong><br /><span
          class="small muted">JPEG, PNG or WebP · up to 8 MB</span
        ><input
          id="image-file"
          type="file"
          accept="image/jpeg,image/png,image/webp"
        /></label
      >
      <div id="image-editor" hidden>
        <p class="small">
          Drag across private details to cover them before reading. Also remove
          any identifiers from the extracted text.
        </p>
        <canvas
          id="image-canvas"
          class="upload-preview"
          aria-label="Image redaction canvas"></canvas>
        <div class="actions">
          <button class="btn" id="reset-image" type="button"
            >Undo all redactions</button
          ><button class="btn" id="clear-image" type="button"
            >Remove image</button>
        </div>
      </div>
      <div class="actions">
        <button class="btn" id="read-image" type="button"
          >Read text on this device</button
        ><button class="btn" id="cancel-ocr" type="button" hidden
          >Cancel reading</button>
      </div>
      <p class="small muted">
        English text reader · downloaded only when requested. First use needs
        several MB of data and may be slow on older phones. You can always type
        or paste instead. No LLM is used.
      </p>
      <p id="ocr-status" class="small" role="status" aria-live="polite">
        Choose an image, or type the claim below.
      </p>
      <label for="query">Review the text or type the claim</label><textarea
        id="query"
        required
        minlength="5"
        maxlength="2000"
        placeholder="Keep the specific claim. Correct errors and remove private details."
      ></textarea>
      <label class="consent"
        ><input id="text-review" type="checkbox" required /><span
          >I have checked this text and removed unnecessary private details.
          Only text will be sent to KEO for source lookup. <a
            href="/methodology/privacy/">Privacy & retention</a
          >.</span
        ></label
      >
      <div class="actions">
        <button class="btn primary" type="submit">Check sources →</button><a
          class="btn"
          href="/sources/">Browse sources directly</a>
      </div>
      <p id="service-state" class="small muted">
        Curated lookup · no paid AI.
      </p><p id="form-error" class="error" role="alert" hidden></p><ol
        id="trace"
        class="trace"
        aria-live="polite"
      >
      </ol>
    </form>
    <div id="result" tabindex="-1"></div>
    <p class="notice">
      Reading text does not authenticate an image or prove a claim true. New
      claims may remain unverified. KEO does not identify private people.
    </p>
    <noscript
      ><p>
        Text extraction needs JavaScript. <a href="/sources/"
          >Read public sources</a
        > or <a href="/methodology/evidence/">follow the evidence checklist</a>.
      </p></noscript
    >
  </div>
  <script>
    import "../scripts/image-editor";
    import "../scripts/local-ocr";
    import "../scripts/investigation";
  </script>
</Layout>
