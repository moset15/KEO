---
import Layout from '../layouts/Layout.astro';
import {sources,evidence} from '../lib/repository';
---
<Layout title="Sources & provenance"><header class="page-intro"><div class="eyebrow">THE PUBLIC RECORD</div><h1>Go straight to the source.</h1><p class="lede">Original publishers, clear provenance and honest coverage. A source in this directory is not a claim that its content has been ingested.</p></header><section class="section"><div class="section-heading"><h2>Evidence currently in the library</h2><span class="tag">{evidence.length} record</span></div>{evidence.map(e=><article class="panel"><span class="eyebrow">{e.publisher} · {e.source_type}</span><h3><a href={e.url}>{e.title} ↗</a></h3><p>{e.excerpt}</p><p class="small muted">Published {e.published_at} · Retrieved {e.retrieved_at.slice(0,10)} · ID {e.id}</p><p class="notice">{e.notes}</p></article>)}</section><section class="section"><h2>Source registry</h2><label for="source-search" class="small">Find a publisher or source type</label><input id="source-search" class="search-field" type="search" placeholder="Search IEBC, legal records, research…"/><p id="source-empty" class="empty" hidden>No matching sources. Try another publisher or category.</p><div class="source-grid">{sources.map(s=><article class="panel" data-source={(s.name+' '+s.category).toLowerCase()}><span class="tag">{s.category.replace('_',' ')}</span><h2><a href={s.url}>{s.name} ↗</a></h2><p class="small muted">{s.notes}</p><dl class="key-value"><dt>Trust classification</dt><dd>{s.trust_level}</dd><dt>Licence</dt><dd>{s.licence}</dd><dt>Redistribution</dt><dd>{s.redistribution_allowed===true?'Permitted under stated terms':s.redistribution_allowed===false?'Link only; permission needed for republication':'Not established; check before reuse'}</dd><dt>API availability / planned review</dt><dd>{s.API_available===null?'Not established':s.API_available?'Available':'Not available'} · {s.refresh_frequency.toLowerCase()}</dd></dl></article>)}</div></section><script>const field=document.querySelector<HTMLInputElement>('#source-search');field?.addEventListener('input',()=>{let count=0;document.querySelectorAll<HTMLElement>('[data-source]').forEach(card=>{card.hidden=!card.dataset.source?.includes(field.value.toLowerCase().trim());if(!card.hidden)count++;});document.querySelector<HTMLElement>('#source-empty')!.hidden=count>0;});</script></Layout>
