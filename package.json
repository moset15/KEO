    "maplibre-gl": "^6.9.0",
    "tesseract.js": "^7.0.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.8",
    "@cloudflare/workers-types": "^5.20260911.1",
    "@playwright/test": "^1.58.2",
    "@types/node": "^22.20.2",
    "drizzle-kit": "^0.31.10",
    "esbuild": "^0.28.2",
    "prettier": "^3.8.1",
    "prettier-plugin-astro": "^0.14.1",
    "typescript": "^5.9.3",
    "vitest": "^4.0.18",
    "wrangler": "^4.72.0"
  }
