---
import "../styles/global.css";
interface Props {
  title: string;
  description?: string;
}
const {
  title,
  description = "Turn election rumours into evidence. KEO is an open-source, non-partisan evidence navigator for Kenya.",
} = Astro.props;
const path = Astro.url.pathname;
const nav = [
  ["Ask", "/ask/", "◌"],
  ["Investigate", "/investigate/", "⌕"],
  ["Map", "/map/", "◇"],
  ["Threats", "/threats/", "▧"],
  ["Sources", "/sources/", "≡"],
];
---

<!doctype html>
<html lang="en-KE">
  <head
    ><meta charset="UTF-8" /><meta
      name="viewport"
      content="width=device-width, initial-scale=1"
    /><meta name="theme-color" content="#006b3f" /><title>
      {title} · KEO
    </title><meta name="description" content={description} /><meta
      property="og:title"
      content={title + " · KEO"}
    /><meta property="og:description" content={description} /><meta
      property="og:type"
      content="website"
    /><link rel="icon" href="/favicon.svg" type="image/svg+xml" /><slot
      name="head"
    /></head
  ><body
    ><a class="skip" href="#main">Skip to content</a><header
      class="site-header"
    >
      <div class="shell header-inner">
        <a href="/" class="brand" aria-label="KEO home"
          ><span class="brand-mark" aria-hidden="true">◎</span><span
            ><strong>KEO</strong><small>Kenya Election Observatory</small></span
          ></a
        ><nav class="desktop-nav" aria-label="Main navigation">
          {
            nav.map(([label, url]) => (
              <a
                href={url}
                aria-current={path.startsWith(url) ? "page" : undefined}
              >
                {label}
              </a>
            ))
          }<a
            href="/methodology/"
            aria-current={path.startsWith("/methodology/") || path === "/about/"
              ? "page"
              : undefined}>Methodology</a
          >
        </nav><a class="github-link" href="https://github.com/moset15/KEO"
          >GitHub ↗</a
        >
      </div>
    </header><main id="main" class="shell"><slot /></main><footer
      class="footer"
    >
      <div class="shell footer-inner">
        <span>KEO · Public evidence. Shared understanding.</span><span
          ><a href="/methodology/">Methodology & roadmap</a> · <a
            href="https://github.com/moset15/KEO">Open source ↗</a
          ></span
        ><span>Independent. Non-partisan. Built in Kenya.</span>
      </div>
    </footer><nav class="mobile-nav" aria-label="Mobile navigation">
      {
        nav.map(([label, url, icon]) => (
          <a
            href={url}
            aria-current={path.startsWith(url) ? "page" : undefined}
          >
            <b aria-hidden="true">{icon}</b>
            {label}
          </a>
        ))
      }
    </nav></body
  >
</html>
