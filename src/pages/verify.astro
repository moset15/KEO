---
import Layout from "../layouts/Layout.astro";
import SourceInputs from "../components/SourceInputs.astro";
import ReviewConsent from "../components/ReviewConsent.astro";
---

<Layout
  title="Read a screenshot & check its claim"
  description="Read screenshot text on your device, review it and inspect public sources without a paid language model."
>
  <div class="workspace">
    <header class="page-intro">
      <div class="eyebrow">ON-DEVICE TEXT READER</div><h1>
        Read the screenshot.<br />Check the evidence.
      </h1><p class="lede">
        Your image stays on this device. Extract its text, correct mistakes,
        then look up the claim in KEO’s curated evidence.
      </p>
    </header>
    <form id="keo-form" data-mode="investigate" data-local-image="true">
      <SourceInputs expanded />
      <label for="query">Review the text or type the claim</label><textarea
        id="query"
        required
        minlength="5"
        maxlength="2000"
        placeholder="Keep the specific claim. Correct errors and remove private details."
      ></textarea>
      <ReviewConsent required />
      <div class="actions">
        <button class="btn primary" type="submit">Check sources →</button><a
          class="btn"
          href="/sources/">Browse sources directly</a
        >
      </div>
      <p id="service-state" class="small muted">
        Curated lookup · no paid AI.
      </p><p id="form-error" class="error" role="alert" hidden></p><ol
        id="trace"
        class="trace"
        aria-live="polite"
      >
      </ol>
    </form>
    <div id="result" tabindex="-1"></div>
    <p class="notice">
      Reading text does not authenticate an image or prove a claim true. New
      claims may remain unverified. KEO does not identify private people.
    </p>
    <noscript
      ><p>
        Text extraction needs JavaScript. <a href="/sources/"
          >Read public sources</a
        > or <a href="/methodology/evidence/">follow the evidence checklist</a>.
      </p></noscript
    >
  </div>
  <script>
    import "../scripts/investigation";
  </script>
</Layout>
